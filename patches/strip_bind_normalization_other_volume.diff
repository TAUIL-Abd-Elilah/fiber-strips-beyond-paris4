+def bind_normalization(spec):
+    """Bind the checkpoint's per-crop z-score record to the CT actually read. The record names the training volume
+    (shared/crop_sampling/normalization.validate_record refuses any other); per-crop z-score keeps no per-volume
+    statistics, so a CT given with --ct (another scroll) gets the same method and epsilon bound to it, as the
+    follower's inference does through prepare_normalization. A no-op for the checkpoint's own volume."""
+    from vesuvius.neural_tracing.tracers.shared.crop_sampling.normalization import (
+        ZSCORE_EPSILON, ZSCORE_METHOD, array_identity, volume_key)
+    from vesuvius.neural_tracing.tracers.shared.crop_sampling.volume import open_ct_array
+    record = spec.ct_normalization
+    if record is None or record.get('volume') == volume_key(spec):
+        return
+    if record.get('method') != ZSCORE_METHOD or record.get('epsilon') != ZSCORE_EPSILON:
+        raise ValueError('Only per-crop z-score CT normalization can be bound to another volume')
+    spec.ct_normalization = dict(method=ZSCORE_METHOD, volume=volume_key(spec), epsilon=ZSCORE_EPSILON,
+                                 **array_identity(open_ct_array(spec, 32 << 20)))
+    print(f"CT per-crop z-score bound to {spec.ct_normalization['volume']} (checkpoint: {record.get('volume')})",
+          flush=True)
+
+
 class StripPredictor:
